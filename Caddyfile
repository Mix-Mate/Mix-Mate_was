# EC2 배포용. DOMAIN은 서버의 .env에서 읽는다.
{$DOMAIN} {
	reverse_proxy mixmate-app:8080

	# 요청별 IP·경로·상태코드·응답시간을 JSON으로 남긴다. 파일 10MiB마다 롤오버, 최근 5개만 보관.
	# 인증번호 발송·검증 API가 email·code를 쿼리스트링으로 받으므로 로그에는 남기지 않는다.
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format filter {
			wrap json
			fields {
				request>uri query {
					delete email
					delete code
				}
			}
		}
	}
}
